PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
DATABASE_URL="mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/rit_central_event_portal?retryWrites=true&w=majority"
# Vercel projects that already define MONGODB_URI can use it instead of DATABASE_URL.

# Cloud storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
